{
  "name": "Client",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome completo",
      "description": "Nome completo do cliente"
    },
    "cpf": {
      "type": "string",
      "title": "CPF",
      "description": "CPF do cliente"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "E-mail"
    },
    "telefone": {
      "type": "string",
      "title": "Telefone"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "title": "Data de nascimento"
    },
    "beneficio_tipo": {
      "type": "string",
      "title": "Tipo de benef\u00edcio",
      "description": "Ex.: Aposentadoria, BPC/LOAS, Aux\u00edlio-Doen\u00e7a"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel",
      "description": "Advogado ou estagi\u00e1rio respons\u00e1vel"
    },
    "situacao": {
      "type": "string",
      "enum": [
        "ativo",
        "aguardando",
        "suspenso",
        "finalizado"
      ],
      "default": "ativo",
      "title": "Situa\u00e7\u00e3o"
    },
    "endereco": {
      "type": "string",
      "title": "Endere\u00e7o"
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}