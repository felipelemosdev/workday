{
  "name": "Task",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome do cliente"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "novo_contato",
        "em_atendimento",
        "documentacao",
        "analise",
        "contrato",
        "requerimento",
        "pericia",
        "acompanhamento",
        "finalizado"
      ],
      "default": "novo_contato",
      "title": "Etapa"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media",
      "title": "Prioridade"
    },
    "vencimento": {
      "type": "string",
      "format": "date",
      "title": "Vencimento"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}