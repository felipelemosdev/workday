{
  "name": "HistoryEvent",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "data": {
      "type": "string",
      "format": "date-time",
      "title": "Data e hora"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "cadastro",
        "agendamento",
        "atendimento",
        "documento",
        "processo",
        "tarefa",
        "observacao"
      ],
      "default": "observacao",
      "title": "Tipo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel"
    }
  },
  "required": [
    "cliente_id",
    "data",
    "descricao"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}