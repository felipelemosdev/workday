{
  "name": "Process",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero do processo"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome do cliente"
    },
    "tipo_beneficio": {
      "type": "string",
      "title": "Tipo de benef\u00edcio"
    },
    "orgao": {
      "type": "string",
      "enum": [
        "INSS",
        "JF",
        "TRF",
        "Outro"
      ],
      "default": "INSS",
      "title": "\u00d3rg\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_analise",
        "aguardando_pericia",
        "pericia_marcada",
        "aguardando_decisao",
        "deferido",
        "indeferido",
        "recurso"
      ],
      "default": "em_analise",
      "title": "Status"
    },
    "data_distribuicao": {
      "type": "string",
      "format": "date",
      "title": "Data de distribui\u00e7\u00e3o"
    },
    "valor": {
      "type": "number",
      "title": "Valor da causa"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel"
    }
  },
  "required": [
    "numero"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}