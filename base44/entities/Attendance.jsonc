{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome do cliente"
    },
    "data": {
      "type": "string",
      "format": "date-time",
      "title": "Data e hora"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Presencial",
        "Telef\u00f4nico",
        "Videoconfer\u00eancia",
        "E-mail",
        "WhatsApp"
      ],
      "default": "Presencial",
      "title": "Tipo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "em_andamento",
        "concluido"
      ],
      "default": "concluido",
      "title": "Status"
    }
  },
  "required": [
    "cliente_nome",
    "data"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}